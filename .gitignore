# =====================================================================
# MONT BARBIER — .gitignore
# Ce que Git ne doit PAS suivre / publier pour ce site statique.
# =====================================================================

# Fichiers générés par le système d'exploitation
.DS_Store
Thumbs.db
desktop.ini

# Fichiers temporaires et sauvegardes d'éditeur
*.tmp
*.bak
*~
*.swp

# Fichiers d'environnement (si un jour vous ajoutez des clés/API) —
# à exclure par précaution, même si ce site n'en a pas besoin pour l'instant
.env
.env.*

# Archives compressées (ne devraient pas se retrouver sur le site public)
*.zip

# Ancienne build locale (copie obsolète, non suivie par Git)
dist/
